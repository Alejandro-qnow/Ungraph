# Copia a .env y rellena. Preferencia: UNGRAPH_*; OpenAI acepta también nombres estándar.

# OPENAI_API_KEY=sk-...
# UNGRAPH_OPENAI_API_KEY=sk-...
# UNGRAPH_OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# UNGRAPH_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# UNGRAPH_INFERENCE_MODE=ner
# UNGRAPH_INFERENCE_MODEL_BUDGET=balanced
# UNGRAPH_INFERENCE_ENRICH_CONTEXT_WITH_LLM=false
# UNGRAPH_INFERENCE_INJECT_SPACY_HINTS=true
# UNGRAPH_OPENAI_MODEL_INFERENCE_CONTEXT=gpt-4o-mini
# UNGRAPH_OPENAI_MODEL_INFERENCE_DOMAIN_QUESTIONS=gpt-4o-mini
# UNGRAPH_OPENAI_MODEL_INFERENCE_EXTRACTION=gpt-4o

# UNGRAPH_INFERENCE_ONTOLOGY_PROFILE_ID=general
# UNGRAPH_ONTOLOGY_SPARQL_ENDPOINT=
# UNGRAPH_ONTOLOGY_SPARQL_PROFILE_ID=sparql
# UNGRAPH_ONTOLOGY_SPARQL_QUERY_NODES_FILE=
# UNGRAPH_ONTOLOGY_SPARQL_QUERY_RELATIONS_FILE=

# UNGRAPH_NEO4J_URI=bolt://localhost:7687
# UNGRAPH_NEO4J_USER=neo4j
# UNGRAPH_NEO4J_PASSWORD=secret
